# Clerk publishable key (get from Clerk dashboard → API Keys).
# Not required when VITE_DEV_NO_AUTH=true.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Base URL for the Wishly FastAPI backend (localhost when you run it yourself)
# Production is https://api.wishly.dev; localhost for a backend you run yourself.
VITE_API_BASE_URL=http://localhost:8000

# Origin serving the signed-in dashboard, e.g. https://app.wishly.dev.
# Leave empty for local dev so the landing page keeps client-side routing to /app.
VITE_APP_BASE_URL=

# Local dev only: skip Clerk in the UI and run as a fixed "Dev User". The API
# has no matching bypass, so its calls will 401 — pair with VITE_MOCK_API=true.
VITE_DEV_NO_AUTH=false

# Local dev only: serve seeded data from an in-browser mock instead of the API.
# With this true, VITE_API_BASE_URL is not required. Leave unset/false otherwise.
VITE_MOCK_API=false
