# Backend (FastAPI + Prefect shared package) environment.
# Copy to `backend/.env` and fill in real values. NEVER commit the real .env.
# This file is for running the backend directly on your machine; the containers
# read infra/.env instead.

# --- Database -------------------------------------------------------------
# Base DSN; the app derives the asyncpg (API) and psycopg (worker) URLs from it.
# Matches the postgres service in infra/compose.local.yaml.
DATABASE_URL=postgresql://wishly:wishly@localhost:5432/wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED unless AUTH_DEV_BYPASS is on: the token issuer / JWKS source.
CLERK_FRONTEND_API=https://your-slug.clerk.accounts.dev

# Local dev only: bypass Clerk JWT verification and authenticate a fixed local
# user (dev@wishly.local). Honored only when ENVIRONMENT != prod. Pair with the
# frontend's VITE_DEV_NO_AUTH=true. NEVER enable in production.
AUTH_DEV_BYPASS=false

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reminders@wishly.dev

# --- App / API ------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=dev

# --- Prefect (only needed to serve the send pipeline locally) --------------
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxxxxxx
