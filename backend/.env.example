# Copy to .env for local development. Every variable is documented in
# src/wishly/settings.py. In production these come from Infisical instead.

# Local Postgres from compose.yaml (or a PlanetScale branch with ?sslmode=verify-full)
WISHLY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishly
# Set to false once everyone who should have an account has one.
WISHLY_SIGNUP_ENABLED=true
WISHLY_CORS_ORIGINS=["http://localhost:5173"]
# Any long random string; EventBridge sends the same value. `openssl rand -hex 32`
WISHLY_RUN_TOKEN=change-me
# Leave unset to print emails to the console instead of sending them.
# WISHLY_RESEND_API_KEY=re_...
