# Backend (FastAPI) environment.
# Copy to `backend/.env` and fill in real values. NEVER commit the real .env.
# This file is for running the backend directly on your machine; the containers
# read infra/.env instead.

# --- Database -------------------------------------------------------------
# Base DSN; the app derives the asyncpg (requests) and psycopg (send pipeline) URLs.
# Matches the postgres service in infra/compose.local.yaml.
DATABASE_URL=postgresql://wishly:wishly@localhost:5432/wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# The token issuer / JWKS source. Defaults to https://clerk.wishly.dev; override
# for a development Clerk instance. Every request is verified against it.
CLERK_FRONTEND_API=https://your-slug.clerk.accounts.dev

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reminders@wishly.dev

# --- App / API ------------------------------------------------------------
APP_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=dev

# --- Internal trigger ------------------------------------------------------
# Shared secret on the X-Wishly-Trigger header, required by every /internal
# route. In production EventBridge sends it on the hourly tick and the detector
# Lambda on every liveness probe; locally it is whatever you want it to be, and
# without it those routes reject everything (they never fail open).
#
#   openssl rand -hex 32
#
#   curl -XPOST localhost:8000/internal/runs/send-reminders \
#     -H "X-Wishly-Trigger: $TRIGGER_TOKEN"
TRIGGER_TOKEN=dev-trigger-token
