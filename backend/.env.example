# Copy to .env for local development. Every variable is documented in
# src/wishly/settings.py. In production they come from the
# cluster's `wishly` Secret instead (synced from Infisical).

# Local Postgres from compose.yaml (prod uses the self-hosted Postgres, as wishly_app)
WISHLY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishly
# Set to false once everyone who should have an account has one.
WISHLY_SIGNUP_ENABLED=true
WISHLY_CORS_ORIGINS=["http://localhost:5173"]
# Any long random string; the watchdog Lambda sends the same value. `openssl rand -hex 32`
WISHLY_PING_TOKEN=change-me
# Locally the 9am sender is usually noise; turn it on to try it.
WISHLY_SCHEDULER_ENABLED=false
# Leave unset to print emails to the console instead of sending them.
# WISHLY_RESEND_API_KEY=re_...
