# Build context is the repo root (infra/compose.yaml uses context: ..).
# Only backend/ is needed by the image — exclude everything noisy.
frontend/
docs/
# Nothing under infra/ enters the image. The exceptions that used to live here
# baked a Dagster instance config in; that orchestrator is long gone, and so is
# the Prefect worker that replaced it. The send pipeline is now a route in the
# API, so the image is just backend/.
infra/
.git/
.github/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/node_modules/
**/dist/
.DS_Store
**/.DS_Store

# Secrets must never enter an image layer.
**/.env
**/.env.*
!**/.env.example

# Tests are not needed at runtime.
backend/tests/
