# Build context is this directory (infra/failover/detection-script).
# Docker does NOT read .gitignore, so the secret exclusions below are the only
# thing keeping the real .env out of an image layer.

# Secrets must never enter an image layer.
.env
.env.*
!.env.example

# Host virtualenv holds macOS binaries — useless and wrong inside linux/amd64.
.venv/

__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
README.md
Dockerfile.failover
