# Tailscale device-staleness detection (failover trigger).
# Copy to `.env` in this directory and fill in real values. NEVER commit the real .env.
# See docs/PLAN.md §11 for the canonical variable list.

# --- Tailscale API --------------------------------------------------------
# REQUIRED. An API access token from the Tailscale admin console
# (Settings -> Keys -> Generate access token). Needs the `device:read` scope.
# Tokens are shown once and expire after 90 days by default.
TAILSCALE_API_KEY=tskey-api-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Slack alerting -------------------------------------------------------
# Incoming webhook posted to when the device is declared down. Treat the whole
# URL as a secret: anyone holding it can post to the channel.
# Create one at https://api.slack.com/apps -> Incoming Webhooks.
# Optional -- if unset, the script logs "skipping alert" and keeps running.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/xxxxxxxxxxxxxxxxxxxxxxxx

# The device being watched, the freshness window, the threshold and the poll
# interval are constants at the top of detect_stale_device.py -- edit them there.
