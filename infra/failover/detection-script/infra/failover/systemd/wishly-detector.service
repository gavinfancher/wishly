# Failover detector — watches the Wishly app host on the tailnet from AWS.
#
# A USER unit, not a system one: podman on the watchdog host is rootless, and the
# detector needs no privileges. Rootless containers die when the user's session
# ends unless lingering is on, so this is required first:
#
#   sudo loginctl enable-linger ubuntu
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp infra/failover/systemd/wishly-detector.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now wishly-detector
#   journalctl --user -u wishly-detector -f

[Unit]
Description=Wishly failover detector (Tailscale staleness watch)
Documentation=file:///opt/wishly-detector/README.md
# Every check is an outbound HTTPS call to api.tailscale.com, so DNS must resolve.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/wishly-detector
ExecStart=/usr/bin/podman run --rm --name wishly-detector \
    --env-file /opt/wishly-detector/.env \
    localhost/wishly-failover-detect:latest
ExecStop=/usr/bin/podman stop -t 10 wishly-detector

# Exit 1 means the watched device is DOWN. That is the failover signal, not a
# crash — restarting would throw away the very state we care about and start the
# three-strike count again from zero. Exit 2 means misconfiguration, which a
# restart cannot fix either. Anything else is an unexpected crash, worth retrying.
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=30s

# Where the failover action hooks in once it exists (DEPLOYMENT-PLAN T2): a
# oneshot calling `aws ec2 start-instances` on the standby.
# OnFailure=wishly-failover.service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=wishly-detector

[Install]
WantedBy=default.target
