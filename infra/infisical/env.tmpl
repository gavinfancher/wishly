{{- /*
  Infisical agent template -> infra/.env

  Every secret the machine identity can read is rendered as KEY=value, so the
  Infisical secret NAMES must match the env var names the app expects. That is
  what keeps this template static: adding a secret in the dashboard propagates
  with no change on any host.

  Non-secret, per-environment configuration is appended as literals below.
*/ -}}
# Rendered by the Infisical agent. DO NOT EDIT — changes are overwritten.
{{ with secret "8cbc2c7e-fa27-4e37-b3c9-15642fc8ca08" "dev" "/" }}
{{- range . }}
{{ .Key }}={{ .Value }}
{{- end }}
{{- end }}

# --- Non-secret local configuration (workstation full-stack test) ----------
POSTGRES_USER=wishly
POSTGRES_PASSWORD=wishly
POSTGRES_DB=wishly
DATABASE_URL=postgresql://wishly:wishly@postgres:5432/wishly

# Real Clerk verification is ON: the bypass is off and stays off.
AUTH_DEV_BYPASS=false
ENVIRONMENT=dev

# Not secrets, so not in Infisical — but CLERK_FRONTEND_API is REQUIRED. Without
# it the API cannot fetch JWKS and every authenticated request 401s while the
# app otherwise looks perfectly healthy.
CLERK_FRONTEND_API=https://clerk.wishly.dev
EMAIL_FROM=reminders@wishly.dev

# The SPA is served from wishly.dev (Cloudflare Worker); the API runs here on
# the Mac behind the api-dev tunnel. Both origins must be listed or the SPA's
# calls fail CORS. localhost stays for running the SPA locally against the mock.
APP_BASE_URL=https://wishly.dev
ALLOWED_ORIGINS=https://wishly.dev,https://www.wishly.dev,http://localhost:5173

PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_POOL=wishly-pool

# TUNNEL_TOKEN comes from Infisical. It must NOT be a literal here: literals are
# rendered after the secret loop, and a later duplicate key wins when Docker
# Compose parses the env file — an empty literal would silently shadow it.
