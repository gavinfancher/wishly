INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev

INFISICAL_CLIENT_ID=
# Universal Auth client secret (short value, not a JWT). Generate under
# Access Control > Identities > <identity> > Authentication > Universal Auth
# > Client Secrets. The script exchanges this for a short-lived access token
# at runtime via login() — this value itself is never sent on API calls.
INFISICAL_CLIENT_SECRET=
