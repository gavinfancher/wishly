# Watches the rendered env file and reloads the stack when it changes.
#
# This exists because the Infisical agent's own `execute` hook does not run on
# the CLI build we have (0.43.128) — it renders, logs success, and silently
# never invokes the command. Watching the file from outside is independent of
# that: anything that rewrites infra/.env triggers a reload, whether it was the
# agent, a rollback, or a human.
#
# Install:
#   sudo cp infra/systemd/wishly-reload.{path,service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wishly-reload.path

[Unit]
Description=Watch infra/.env and reload the Wishly stack when it changes

[Path]
# PathChanged fires on close-after-write, so a partially written file cannot
# trigger a reload mid-render.
PathChanged=/opt/wishly/infra/.env
Unit=wishly-reload.service

[Install]
WantedBy=multi-user.target
