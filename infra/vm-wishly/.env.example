# vm-wishly — the application tier. Rendered by the Infisical agent in
# production (docs/runbooks/secrets.md); copy to `infra/vm-wishly/.env` only for
# a manual bring-up.
#
# This VM's machine identity reads ONLY these. It has no access to the Postgres
# superuser password or the S3 backup credentials.

# --- Database (on vm-db, over the VPN) ------------------------------------
# Host is vm-db's VPN address — not the `postgres` compose service name, which
# no longer exists on this VM.
DATABASE_URL=postgresql://wishly:replace_me@10.0.0.20:5432/wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# REQUIRED. The token issuer / JWKS source. Without it the API cannot verify a
# single token and every authenticated request returns 401 while the app
# otherwise looks completely healthy.
CLERK_FRONTEND_API=https://clerk.wishly.dev

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SIGNING_SECRET=whsec_replace_me
EMAIL_FROM=reminders@wishly.dev

# --- App / API ------------------------------------------------------------
APP_BASE_URL=https://wishly.dev
# Both hosts call the API: the marketing page and the dashboard. Omitting either
# makes the dashboard's requests fail CORS.
ALLOWED_ORIGINS=https://wishly.dev,https://app.wishly.dev
# `prod` also permanently disables AUTH_DEV_BYPASS regardless of that flag.
ENVIRONMENT=prod

# --- Prefect --------------------------------------------------------------
# Server and worker both run on this VM, so the API URL stays internal.
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_POOL=wishly-pool

# Server state lives in the `prefect` database on vm-db (DEPLOYMENT-PLAN T2),
# which is what keeps this VM stateless. Prefect requires the asyncpg driver.
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://prefect:replace_me@10.0.0.20:5432/prefect

# The VPN address to bind the Prefect UI to. The self-hosted OSS UI has no
# authentication of its own — never publish it.
PREFECT_UI_BIND_ADDRESS=10.0.0.10

# --- Cloudflare Tunnel ----------------------------------------------------
TUNNEL_TOKEN=replace_me
