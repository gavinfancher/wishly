# vm-db — Wishly's tenant credentials + backup config on the shared database host.
# Rendered by the Infisical agent in production (docs/runbooks/secrets.md).
#
# Note this VM does NOT run Postgres for Wishly — `homecloud-postgres` is
# pre-existing shared infrastructure. These are the tenant role passwords created
# by sql/create_tenant.sql, needed here only so the backup job can connect.

# --- Tenant roles ---------------------------------------------------------
WISHLY_DB_PASSWORD=replace_me
PREFECT_DB_PASSWORD=replace_me

# --- Backups to S3 --------------------------------------------------------
# Any S3-compatible store works. For Cloudflare R2 set S3_ENDPOINT_URL to
# https://<account-id>.r2.cloudflarestorage.com and AWS_DEFAULT_REGION=auto.
S3_BUCKET=wishly-backups
S3_PREFIX=wishly/postgres
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Remote retention: keep the newest N dumps (DEPLOYMENT-PLAN T4).
BACKUP_KEEP_LAST=48
