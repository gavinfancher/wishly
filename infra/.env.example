# Infrastructure / deployment environment (docker compose, tunnel).
# Copy to `infra/.env` and fill in real values. NEVER commit the real .env.
# See docs/PLAN.md §11 for the canonical variable list.

# --- Postgres (consumed by docker-compose) --------------------------------
POSTGRES_USER=wishly
POSTGRES_PASSWORD=wishly
POSTGRES_DB=wishly

# --- Database DSN (passed to api / dagster containers) ---------------------
# In the full compose stack the host is the `postgres` service, not localhost.
DATABASE_URL=postgresql://wishly:wishly@postgres:5432/wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reminders@wishly.dev

# --- App / API ------------------------------------------------------------
APP_BASE_URL=https://wishly.dev
ALLOWED_ORIGINS=https://wishly.dev
ENVIRONMENT=dev

# --- Dagster --------------------------------------------------------------
DAGSTER_HOME=/opt/dagster/dagster_home

# --- Cloudflare Tunnel ----------------------------------------------------
TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
