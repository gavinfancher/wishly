# Infrastructure / deployment environment (docker compose, tunnel).
# Copy to `infra/.env` and fill in real values. NEVER commit the real .env.
# In production this file is rendered by the Infisical agent — see
# docs/runbooks/secrets.md.

# --- Database -------------------------------------------------------------
# Production: the RDS endpoint, reached over the VPN.
#   postgresql://wishly:<password>@<name>.<id>.<region>.rds.amazonaws.com:5432/wishly
# With the compose.local.yaml overlay the host is the `postgres` service instead.
DATABASE_URL=postgresql://wishly:wishly@postgres:5432/wishly

# Consumed ONLY by the postgres container in compose.local.yaml. Production has
# no local Postgres, so these are unused there.
POSTGRES_USER=wishly
POSTGRES_PASSWORD=wishly
POSTGRES_DB=wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED. The token issuer / JWKS source. Without it the API cannot verify a
# single token and every authenticated request returns 401 while the app
# otherwise looks healthy. Development instances look like
# https://<slug>.clerk.accounts.dev; a production instance uses your own domain.
# (Set CLERK_JWKS_URL instead to point at the JWKS endpoint directly.)
CLERK_FRONTEND_API=https://clerk.example.com

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reminders@example.com

# --- App / API ------------------------------------------------------------
APP_BASE_URL=https://example.com
# Every origin that calls the API — the marketing page and the dashboard.
ALLOWED_ORIGINS=https://example.com,https://app.example.com
ENVIRONMENT=dev

# --- Prefect --------------------------------------------------------------
# Prefect Cloud is the control plane: it holds the schedule, run history, and UI,
# while flows execute in the `worker` container here (`serve()`). Keeping the
# scheduler off this host is deliberate — the standby EC2 exists for the case
# where this host is gone, and a scheduler running here would be gone with it.
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backups to S3 (optional, compose.backup.yaml) ------------------------
# Any S3-compatible store works. For Cloudflare R2 set S3_ENDPOINT_URL to
# https://<account-id>.r2.cloudflarestorage.com and AWS_DEFAULT_REGION=auto.
S3_BUCKET=wishly-backups
S3_PREFIX=wishly/postgres
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Cloudflare Tunnel ----------------------------------------------------
TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
