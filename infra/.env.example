# Infrastructure / deployment environment (docker compose, tunnel).
# Copy to `infra/.env` and fill in real values. NEVER commit the real .env.
# See docs/PLAN.md §11 for the canonical variable list.

# --- Postgres (consumed by docker-compose) --------------------------------
POSTGRES_USER=wishly
POSTGRES_PASSWORD=wishly
POSTGRES_DB=wishly

# --- Database DSN (passed to api / worker containers) ----------------------
# In the full compose stack the host is the `postgres` service, not localhost.
DATABASE_URL=postgresql://wishly:wishly@postgres:5432/wishly

# --- Clerk (auth) ---------------------------------------------------------
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED. The token issuer / JWKS source. Without it the API cannot verify a
# single token and every authenticated request returns 401. Development
# instances look like https://<slug>.clerk.accounts.dev; a production instance
# uses your own domain, e.g. https://clerk.wishly.dev. (Set CLERK_JWKS_URL
# instead if you want to point at the JWKS endpoint directly.)
CLERK_FRONTEND_API=https://clerk.wishly.dev

# --- Resend (email) -------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=reminders@wishly.dev

# --- App / API ------------------------------------------------------------
APP_BASE_URL=https://wishly.dev
# Both hosts call the API: the marketing page and the dashboard.
ALLOWED_ORIGINS=https://wishly.dev,https://app.wishly.dev
ENVIRONMENT=dev

# --- Prefect --------------------------------------------------------------
# Self-hosted server inside the compose stack (the default). Prefect Cloud's
# free plan only offers *managed* work pools, which run flows on Prefect's
# infrastructure and therefore cannot reach this Postgres — it publishes no
# ports and lives behind the tunnel.
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_WORK_POOL=wishly-pool

# Using Prefect Cloud instead (needs a plan with hybrid work pools): set the
# workspace URL above and uncomment the key. Nothing else changes.
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
# PREFECT_API_KEY=pnu_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Backups to S3 --------------------------------------------------------
# Any S3-compatible store works. For Cloudflare R2 set S3_ENDPOINT_URL to
# https://<account-id>.r2.cloudflarestorage.com and AWS_DEFAULT_REGION=auto.
S3_BUCKET=wishly-backups
S3_PREFIX=wishly/postgres
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Cloudflare Tunnel ----------------------------------------------------
TUNNEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
