# syntax=docker/dockerfile:1.7
#
# Prefect worker image (PLAN T7.1). Polls Prefect Cloud for scheduled runs of
# the send flow and executes them in this container — the scheduler and UI are
# Cloud's, so nothing orchestration-related is self-hosted.
# Build context is the repo root (same as Dockerfile.api).

# ---- builder: resolve and install deps into a self-contained .venv -----------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---- runtime -----------------------------------------------------------------
FROM python:3.12-slim AS runtime

RUN groupadd --system app && useradd --system --gid app --create-home app

ENV PATH="/app/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app/backend
COPY --from=builder --chown=app:app /app/backend /app/backend

USER app

# The work pool name is supplied by compose; PREFECT_API_URL/KEY authenticate to Cloud.
CMD ["prefect", "worker", "start", "--pool", "wishly-pool"]
