# syntax=docker/dockerfile:1.7
#
# Send-pipeline image. Runs Prefect's serve(): registers the deployments with
# their schedules against PREFECT_API_URL, then executes flow runs in subprocesses
# of this container. The scheduler and UI are Prefect Cloud's, so nothing
# orchestration-related is self-hosted.
# Build context is the repo root (same as Dockerfile.api).

# ---- builder: resolve and install deps into a self-contained .venv -----------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./
# --group worker adds Prefect, which the API image deliberately does without.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group worker --no-install-project

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group worker

# ---- runtime -----------------------------------------------------------------
FROM python:3.12-slim AS runtime

RUN groupadd --system app && useradd --system --gid app --create-home app

ENV PATH="/app/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app/backend
COPY --from=builder --chown=app:app /app/backend /app/backend

USER app

# Load config from Secrets Manager (if WISHLY_SECRETS_ID is set), then exec.
ENTRYPOINT ["python", "-m", "wishly.bootstrap"]

# PREFECT_API_URL/KEY authenticate to Cloud. Pass --once to run the send a single
# time and exit instead of serving.
CMD ["python", "-m", "wishly.orchestration.flows"]
