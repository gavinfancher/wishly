# syntax=docker/dockerfile:1.7
#
# Dagster image (PLAN T7.1) — one image, two entrypoints. docker-compose.yml runs
# it twice with different commands:
#   webserver: dagster-webserver -h 0.0.0.0 -p 3000 -w $DAGSTER_HOME/workspace.yaml
#   daemon:    dagster-daemon run -w $DAGSTER_HOME/workspace.yaml
# Build context is the repo root (same as Dockerfile.api).

# ---- builder: resolve and install deps into a self-contained .venv -----------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app/backend

COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---- runtime -----------------------------------------------------------------
FROM python:3.12-slim AS runtime

RUN groupadd --system app && useradd --system --gid app --create-home app

ENV PATH="/app/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DAGSTER_HOME=/opt/dagster/dagster_home

WORKDIR /app/backend
COPY --from=builder --chown=app:app /app/backend /app/backend

# Instance + workspace config live in DAGSTER_HOME (shared Postgres storage).
COPY --chown=app:app infra/dagster/dagster.yaml infra/dagster/workspace.yaml ${DAGSTER_HOME}/
RUN chown -R app:app /opt/dagster

USER app
EXPOSE 3000

# Default to the webserver; the daemon service overrides `command` in compose.
CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "3000", "-w", "/opt/dagster/dagster_home/workspace.yaml"]
